# MongoDB Atlas: replace the placeholders with the connection string from Atlas
# If the password has special characters, URL-encode it (for example, @ becomes %40).
MONGO_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/quizplatform?retryWrites=true&w=majority&appName=QuizPlatform

# Use a long, unique random value in every deployed environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
PORT=5000
# Comma-separated origins are supported, useful when deploying the frontend.
CORS_ORIGIN=http://localhost:5173
